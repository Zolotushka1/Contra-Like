    - target: {fileID: 9109193655387487121, guid: b999624184b77f747addc4b30fd98610, type: 3}
      propertyPath: description
      value: "\u0413\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u0441\u0435\u043A\u0442\u043E\u0440\n\n\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435
        \u0443\u043B\u0438\u0446\u044B \u043D\u043E\u0447\u043D\u043E\u0433\u043E
        \u0433\u043E\u0440\u043E\u0434\u0430 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0439\u0442\u0435\u0441\u044C
        \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
        \u2014 \u043D\u0430\u0437\u0435\u043C\u043D\u044B\u0435 \u0431\u043E\u0439\u0446\u044B,
        \u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0435 \u0432\u0440\u0430\u0433\u0438
        \u0438 \u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
        \u043C\u0430\u0448\u0438\u043D\u0430 \u0441 \u0442\u0443\u0440\u0435\u043B\u044C\u044E."
