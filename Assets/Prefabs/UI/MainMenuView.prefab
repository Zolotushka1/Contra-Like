    - target: {fileID: 9109193655387487121, guid: b999624184b77f747addc4b30fd98610, type: 3}
      propertyPath: description
      value: "\u041A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F\n\n\u041F\u0435\u0440\u0435\u0441\u0435\u043A\u0438\u0442\u0435
        \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u043E\u0440\u044B \u0438 \u0442\u043E\u043A\u0441\u0438\u0447\u043D\u044B\u0435
        \u0441\u0442\u043E\u043A\u0438. \u0414\u0432\u043E\u0439\u043D\u043E\u0439
        \u043F\u0440\u044B\u0436\u043E\u043A \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
